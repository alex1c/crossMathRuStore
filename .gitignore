# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env / secrets (never commit)
.env
.env.*
!.env.example
.env*.local
secrets/
signing/
credentials.json
credentials/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# tooling / coverage
coverage/
*.log

# IDE / agent noise
.claude/
.idea/
.tmp-*/

# Built binaries
*.apk
*.aab
release-artifacts/*.apk
release-artifacts/*.aab
# Keep listing assets (icon-512) — never commit keystores or password files
signing.properties
**/keystore.properties
*.pepk
